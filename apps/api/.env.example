# Port the API listens on
PORT=3001
# SQLite database file (created automatically). Safe default for local dev.
DATABASE_URL=file:./data/app.db
# Signs the session cookie (ADR 0002). This default is public and only for local dev;
# with NODE_ENV=production the API refuses to start unless you set a long random value.
SESSION_SECRET=dev-only-secret-change-me
# Audit log retention in days (ADR 0012). A daily job deletes older events.
# Read events (GET) are kept briefly; changes and sign-ins longer, for disputed invoices.
# Confirm the periods with the client's data protection officer before production.
AUDIT_RETENTION_READ_DAYS=90
AUDIT_RETENTION_CHANGE_DAYS=365
