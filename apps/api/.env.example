# Port the API listens on
PORT=3001
# SQLite database file (created automatically). Safe default for local dev.
DATABASE_URL=file:./data/app.db
# Signs the session cookie (ADR 0002). This default is public and only for local dev;
# with NODE_ENV=production the API refuses to start unless you set a long random value.
SESSION_SECRET=dev-only-secret-change-me
# Reverse proxies in front of the API (e.g. 1 behind nginx). Used for the client IP in the audit log (ADR 0012).
# Keep 0 when the API is reached directly: otherwise a client could fake its IP with an X-Forwarded-For header.
TRUST_PROXY_HOPS=0

