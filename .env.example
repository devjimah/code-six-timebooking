# Settings for `docker compose up`. All optional: these are the defaults.
# To change one, copy this file to .env. The settings for `npm run dev` are in apps/api/.env.example.

# The port of the web app on your machine. The API is reached through it, at /api.
WEB_PORT=5173
# Signs the session cookie (ADR 0002). This default is public and only for the demo; set a long random value otherwise.
SESSION_SECRET=dev-only-secret-change-me
# How long purchasing needs for a follow-up order. The forecast says when to start (ADR 0015).
PURCHASING_LEAD_TIME_WEEKS=4
# Booking from a sentence (ADR 0022). mock: rule-based, no key, no data leaves the system. off: switched off.
AI_MODE=mock
